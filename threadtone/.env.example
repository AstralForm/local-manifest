# Slack app credentials (from api.slack.com or `slack run`)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# Optional: LLM provider for higher-quality rewrites
# Leave unset to use the built-in heuristic rewriter
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=openai   # openai | anthropic | auto

# Optional: local HTTP API for the Mac companion app (default off)
# ENABLE_LOCAL_API=true
# LOCAL_API_PORT=8787
# LOCAL_API_TOKEN=change-me
